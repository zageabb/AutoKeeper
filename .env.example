# Copy privately to .env and chmod 600 .env
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
AUTOKEEPER_AUTH_MODE=basic
DVLA_API_KEY=
AUTOKEEPER_DB_PATH=/opt/autokeeper/data/autokeeper.db
# LOCAL_UBUNTU_PROXY_COMPAT: empty for direct localhost; prefix for Caddy/UDA
AUTOKEEPER_ROOT_PATH=/apps/autokeeper
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
SMTP_APP_PASSWORD=
AUTOKEEPER_DEV_NO_AUTH=0

# Port 5092 is configured in systemd ExecStart and Caddy, not as an env var.

# Ollama chat API (server-to-server only; DO NOT expose port 11434 publicly)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_READ_TIMEOUT=300
# Optional; defaults to data/knowledge.md beside SQLite database.
AUTOKEEPER_KNOWLEDGE_PATH=/opt/autokeeper/data/knowledge.md
